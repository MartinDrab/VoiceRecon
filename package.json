{
  "name": "voicerecon",
  "version": "0.1.0",
  "private": true,
  "description": "Realtime speech-to-text with speaker recognition (Czech and English), running fully offline.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "models": "node scripts/download-models.js",
    "create-user": "node scripts/create-user.js",
    "evaluate": "node scripts/evaluate.js",
    "export-test": "node scripts/export-test.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p public/tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.3.0",
    "sherpa-onnx-node": "1.13.8",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3"
  }
}
