# VoiceRecon's settings, read by its service and by the voicerecon command. After a change:
#   sudo systemctl restart voicerecon
# All settings are described in /usr/share/doc/voicerecon/README.md ("Configuration").

# Where it listens. 127.0.0.1: only this computer. 0.0.0.0: also other devices; then use HTTPS
# (TLS_CERT and TLS_KEY, files the user voicerecon can read, e.g. in /etc/voicerecon) or a reverse
# proxy in front of it, because browsers let only secure pages use the microphone.
HOST=127.0.0.1
PORT=3000
#TLS_CERT=/etc/voicerecon/cert.pem
#TLS_KEY=/etc/voicerecon/key.pem

# The data (users, voices, transcripts and their audio) and the speech models (about 3 GB, downloaded
# on the first start). Both stay when the package is removed. Elsewhere than /var/lib/voicerecon,
# the service must be allowed to write there: sudo systemctl edit voicerecon, then
#   [Service]
#   ReadWritePaths=/srv/voicerecon
DATA_DIR=/var/lib/voicerecon/data
MODELS_DIR=/var/lib/voicerecon/models

# Threads for speech recognition (default: the CPU cores, at most 4).
#THREADS=4
